@page "/Employee/Details/{Id:guid}"
@using Hydra.Core.HumanResources

<PageTitle>Çalışan Detayı</PageTitle>

<GenericDetailsView T="Employee" Client="Client" Id="@Id" Title="Çalışan Detayı" />

@code {
