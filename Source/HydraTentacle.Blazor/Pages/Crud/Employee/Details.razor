@page "/Employee/Details/{Id:guid}"
@attribute [HydraRequirePermission("Employee", "Details")]
@using Hydra.Core.HumanResources

<PageTitle>Employee Details</PageTitle>

<GenericDetailsView T="Employee" Client="Client" Id="@Id" Title="Employee Details" />

@code {
    [Parameter] public Guid Id { get; set; }

    [Inject] public ApiClient<Employee> Client { get; set; } = default!;
}
