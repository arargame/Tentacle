@page "/OrganizationUnit/Details/{Id:guid}"
@using Hydra.Core.HumanResources

<PageTitle>Organization Unit Details</PageTitle>

<GenericDetailsView T="OrganizationUnit" Client="Client" Id="@Id" Title="Organization Unit Details">
    <CollectionViewSection Title="Positions"
                           Controller="Position"
                           ForeignKeyName="OrganizationUnitId"
                           ParentId="@Id" />
</GenericDetailsView>

@code {
    [Parameter] public Guid Id { get; set; }

    [Inject] public ApiClient<OrganizationUnit> Client { get; set; } = default!;
}
