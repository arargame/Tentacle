@page "/RequestCategory/Details/{Id:guid}"
@using HydraTentacle.Core.Models.Request

<PageTitle>Request Category Details</PageTitle>

<GenericDetailsView T="RequestCategory" Client="Client" Id="@Id" Title="Request Category Details">
    <CollectionViewSection Title="Requests"
                           Controller="Request"
                           ForeignKeyName="RequestCategoryId"
                           ParentId="@Id" />

    <CollectionViewSection Title="Responsible Positions"
                           Controller="RequestCategoryResponsiblePosition"
                           ForeignKeyName="RequestCategoryId"
                           ParentId="@Id" />
</GenericDetailsView>

@code {
    [Parameter] public Guid Id { get; set; }

    [Inject] public ApiClient<RequestCategory> Client { get; set; } = default!;
}
