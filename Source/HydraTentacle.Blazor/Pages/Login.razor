@page "/Login"
@layout EmptyLayout
@inject NavigationManager Navigation

@* Tentacle giriş ekranı — Stitch'in ürettiği login tasarımının Blazor'a uyarlanmış hali.
   Tailwind CDN + Google Fonts sadece bu sayfada, HeadContent üzerinden yüklenir (Home.razor'daki
   ile aynı desen). Gerçek kimlik doğrulama (Hydra AccessManagement / AuthenticationService /
   HydraAuthenticationStateProvider) henüz bağlı değil (bkz. TENTACLE_SETUP.md, "Bilinen Kısıtlar") —
   bu yüzden "Log In" şimdilik sadece Dashboard'a yönlendiren bir yer tutucu; gerçek auth akışı
   kurulduğunda HandleLogin() içindeki TODO'yu değiştirmek yeterli. Şifre göster/gizle butonu ise
   gerçekten çalışıyor.*@

<PageTitle>Login - Tentacle Engine</PageTitle>

<HeadContent>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary-fixed-dim": "#2fd9f4",
                        "surface": "#101415",
                        "inverse-surface": "#e0e3e5",
                        "on-tertiary-fixed": "#0b1c30",
                        "on-background": "#e0e3e5",
                        "on-surface-variant": "#bbc9cd",
                        "on-primary-fixed-variant": "#004e5a",
                        "on-secondary-container": "#afb4c9",
                        "surface-container-lowest": "#0b0f10",
                        "on-tertiary": "#213145",
                        "on-primary-container": "#005763",
                        "surface-container-highest": "#323537",
                        "on-tertiary-container": "#405065",
                        "on-surface": "#e0e3e5",
                        "secondary-fixed-dim": "#c1c6db",
                        "on-error": "#690005",
                        "on-secondary": "#2a3040",
                        "surface-variant": "#323537",
                        "on-error-container": "#ffdad6",
                        "on-tertiary-fixed-variant": "#38485d",
                        "outline-variant": "#3c494c",
                        "tertiary-fixed": "#d3e4fe",
                        "surface-container-low": "#191c1e",
                        "outline": "#859397",
                        "tertiary-fixed-dim": "#b7c8e1",
                        "surface-container-high": "#272a2c",
                        "surface-container": "#1d2022",
                        "tertiary-container": "#b2c2dc",
                        "inverse-primary": "#006877",
                        "primary": "#8aebff",
                        "surface-bright": "#363a3b",
                        "on-primary-fixed": "#001f25",
                        "secondary-fixed": "#dde2f8",
                        "surface-dim": "#101415",
                        "on-primary": "#00363e",
                        "tertiary": "#cddef8",
                        "error-container": "#93000a",
                        "background": "#101415",
                        "secondary-container": "#414658",
                        "inverse-on-surface": "#2d3133",
                        "on-secondary-fixed": "#151b2b",
                        "primary-fixed": "#a2eeff",
                        "primary-container": "#22d3ee",
                        "surface-tint": "#2fd9f4",
                        "secondary": "#c1c6db",
                        "error": "#ffb4ab",
                        "on-secondary-fixed-variant": "#414658"
                    },
                    borderRadius: {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    spacing: {
                        "xl": "40px",
                        "sm": "8px",
                        "margin-mobile": "16px",
                        "xs": "4px",
                        "margin-desktop": "48px",
                        "lg": "24px",
                        "unit": "4px",
                        "md": "16px",
                        "gutter": "24px"
                    },
                    fontFamily: {
                        "body-lg": ["Geist"],
                        "headline-lg-mobile": ["Geist"],
                        "headline-md": ["Geist"],
                        "headline-lg": ["Geist"],
                        "body-md": ["Geist"],
                        "mono-code": ["Geist"],
                        "label-md": ["Geist"],
                        "label-sm": ["Geist"],
                        "display-lg": ["Geist"]
                    },
                    fontSize: {
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                        "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "mono-code": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "label-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500" }],
                        "label-sm": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600" }],
                        "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }]
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="css/login.css" />
</HeadContent>

<div class="bg-background text-on-background min-h-screen flex flex-col md:flex-row antialiased font-body-md">

    <!-- Left Side: Login Card -->
    <div class="w-full md:w-1/2 min-h-screen flex items-center justify-center p-margin-mobile md:p-margin-desktop relative z-10 bg-background overflow-hidden">
        <!-- Subtle background grid effect -->
        <div class="absolute inset-0 z-0 opacity-[0.03] pointer-events-none" style="background-image: linear-gradient(#859397 1px, transparent 1px), linear-gradient(90deg, #859397 1px, transparent 1px); background-size: 24px 24px;"></div>

        <div class="w-full max-w-md z-10 relative">
            <!-- Brand Header -->
            <div class="mb-xl text-center md:text-left flex flex-col items-center md:items-start">
                <div class="w-12 h-12 bg-surface-container border border-outline-variant rounded-lg flex items-center justify-center mb-lg shadow-[0_0_12px_rgba(34,211,238,0.1)] relative">
                    <span class="material-symbols-outlined text-primary-container text-[28px]" style="font-variation-settings: 'FILL' 1;">hub</span>
                    <div class="absolute -top-1 -right-1 w-2 h-2 bg-primary-container rounded-full shadow-[0_0_8px_rgba(34,211,238,0.8)]"></div>
                </div>
                <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-sm tracking-tight">Welcome back</h1>
                <p class="font-body-md text-body-md text-on-surface-variant">Log in to your Tentacle workspace.</p>
            </div>

            <!-- Login Form -->
            <form class="space-y-lg" @onsubmit="HandleLogin" @onsubmit:preventDefault="true">
                <!-- Email Field -->
                <div class="space-y-sm">
                    <label class="font-label-sm text-label-sm text-on-surface-variant block uppercase tracking-wider" for="email">Email Address</label>
                    <div class="relative bg-surface-container rounded border border-outline-variant transition-all duration-200 input-glow">
                        <span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">mail</span>
                        <input class="w-full bg-transparent border-none py-md pl-[44px] pr-md text-on-surface font-body-md placeholder-on-surface-variant/50 focus:ring-0 focus:outline-none rounded"
                               id="email" placeholder="name@company.com" required type="email" @bind="_email" />
                    </div>
                </div>

                <!-- Password Field -->
                <div class="space-y-sm">
                    <div class="flex justify-between items-center">
                        <label class="font-label-sm text-label-sm text-on-surface-variant block uppercase tracking-wider" for="password">Password</label>
                        <a class="font-label-sm text-label-sm text-primary hover:text-primary-container transition-colors" href="#">Forgot password?</a>
                    </div>
                    <div class="relative bg-surface-container rounded border border-outline-variant transition-all duration-200 input-glow">
                        <span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">lock</span>
                        <input class="w-full bg-transparent border-none py-md pl-[44px] pr-[44px] text-on-surface font-body-md placeholder-on-surface-variant/50 focus:ring-0 focus:outline-none rounded"
                               id="password" placeholder="••••••••" required type="@(_showPassword ? "text" : "password")" @bind="_password" />
                        <button class="absolute right-md top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition-colors focus:outline-none"
                                type="button" @onclick="TogglePasswordVisibility">
                            <span class="material-symbols-outlined text-[20px]">@(_showPassword ? "visibility_off" : "visibility")</span>
                        </button>
                    </div>
                </div>

                <!-- Submit Button -->
                <button class="w-full bg-primary-container text-surface-container-lowest font-label-md text-label-md py-md px-lg rounded font-bold uppercase tracking-wide hover:bg-primary transition-all duration-200 shadow-[0_0_12px_rgba(34,211,238,0.2)] hover:shadow-[0_0_16px_rgba(34,211,238,0.4)] active:scale-[0.98]"
                        type="submit">
                    Log In
                </button>

                <!-- Divider -->
                <div class="flex items-center gap-md py-sm">
                    <div class="h-px bg-outline-variant flex-1"></div>
                    <span class="font-label-sm text-label-sm text-on-surface-variant uppercase">Or continue with</span>
                    <div class="h-px bg-outline-variant flex-1"></div>
                </div>

                <!-- SSO Buttons -->
                <div class="grid grid-cols-2 gap-md">
                    <button class="flex items-center justify-center gap-sm py-sm px-md border border-outline-variant rounded bg-surface hover:bg-surface-container transition-colors duration-200 group" type="button">
                        <svg class="w-5 h-5 text-on-surface-variant group-hover:text-on-surface transition-colors" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12.545,10.239v3.821h5.445c-0.712,2.315-2.647,3.972-5.445,3.972c-3.332,0-6.033-2.701-6.033-6.032s2.701-6.032,6.033-6.032c1.498,0,2.866,0.549,3.921,1.453l2.814-2.814C17.503,2.988,15.139,2,12.545,2C7.021,2,2.543,6.477,2.543,12s4.478,10,10.002,10c8.396,0,10.249-7.85,9.426-11.748L12.545,10.239z" />
                        </svg>
                        <span class="font-label-md text-label-md text-on-surface">Google</span>
                    </button>
                    <button class="flex items-center justify-center gap-sm py-sm px-md border border-outline-variant rounded bg-surface hover:bg-surface-container transition-colors duration-200 group" type="button">
                        <svg class="w-5 h-5 text-on-surface-variant group-hover:text-on-surface transition-colors" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M11.4 24H0V12.6h11.4V24zM24 24H12.6V12.6H24V24zM11.4 11.4H0V0h11.4v11.4zm12.6 0H12.6V0H24v11.4z" />
                        </svg>
                        <span class="font-label-md text-label-md text-on-surface">Microsoft</span>
                    </button>
                </div>
            </form>

            <!-- Footer Link -->
            <p class="mt-xl text-center font-body-md text-body-md text-on-surface-variant">
                Don't have an account?
                <a class="text-primary hover:text-primary-container font-medium transition-colors border-b border-primary/30 hover:border-primary-container" href="#">Request access</a>
            </p>
        </div>
    </div>

    <!-- Right Side: Branded Panel (Hidden on mobile) -->
    <div class="hidden md:flex w-1/2 min-h-screen relative overflow-hidden bg-[#050b14] border-l border-outline-variant/30 flex-col justify-end p-margin-desktop">
        <div class="absolute inset-0 bg-gradient-to-tr from-[#020610] via-[#051329] to-[#0a2342] opacity-80 z-0"></div>

        <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none opacity-40 mix-blend-screen">
            <div class="absolute top-[20%] left-[-10%] w-[120%] h-[1px] bg-gradient-to-r from-transparent via-primary-container to-transparent transform -rotate-12 blur-[2px] opacity-70"></div>
            <div class="absolute top-[30%] left-[-10%] w-[120%] h-[2px] bg-gradient-to-r from-transparent via-primary to-transparent transform -rotate-6 blur-[4px] opacity-50 neural-node" style="animation-delay: 0s;"></div>
            <div class="absolute top-[50%] left-[-10%] w-[120%] h-[1px] bg-gradient-to-r from-transparent via-secondary-fixed to-transparent transform rotate-12 blur-[1px] opacity-40 neural-node" style="animation-delay: 2s;"></div>
            <div class="absolute top-[70%] left-[-10%] w-[120%] h-[3px] bg-gradient-to-r from-transparent via-primary-container to-transparent transform rotate-6 blur-[6px] opacity-60 neural-node" style="animation-delay: 1s;"></div>
            <div class="absolute top-[85%] left-[-10%] w-[120%] h-[1px] bg-gradient-to-r from-transparent via-primary to-transparent transform -rotate-3 blur-[2px] opacity-80 neural-node" style="animation-delay: 3s;"></div>
            <div class="absolute top-[30%] right-[30%] w-32 h-32 bg-primary-container rounded-full blur-[80px] opacity-20"></div>
            <div class="absolute bottom-[20%] left-[20%] w-48 h-48 bg-primary-fixed rounded-full blur-[100px] opacity-10"></div>
        </div>

        <div class="relative z-10 max-w-lg mb-xl">
            <h2 class="font-display-lg text-display-lg text-on-surface mb-md leading-tight text-transparent bg-clip-text bg-gradient-to-br from-white to-tertiary-fixed-dim">
                Every request finds its way home.
            </h2>
            <div class="w-12 h-1 bg-primary-container shadow-[0_0_8px_rgba(34,211,238,0.5)]"></div>
        </div>
    </div>

</div>

@code {
    private bool _showPassword;
    private string _email = string.Empty;
    private string _password = string.Empty;

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private void HandleLogin()
    {
        //TODO: Gerçek kimlik doğrulama henüz bağlı değil (Hydra AccessManagement / AuthenticationService /
        //HydraAuthenticationStateProvider hazır ama buraya kablolanmadı — bkz. TENTACLE_SETUP.md).
        //Şimdilik tasarımı doğrulamak için doğrudan Dashboard'a yönlendiriyor.
        Navigation.NavigateTo("Dashboard");
    }
}
