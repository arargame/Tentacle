@using Hydra.RazorClassLibrary.Components.Security
@using Hydra.RazorClassLibrary.Pages

@* Yönlendirme artık kapalı başlıyor.

   Düz <RouteView> her sayfayı herkese açıyordu; <AuthorizeRouteView> de yalnızca [Authorize]
   taşıyan sayfaları koruduğu için, attribute konmayı unutulan bir sayfa sessizce açık kalırdı.
   HydraRouteGuard bunu tersine çeviriyor: her rota giriş yapmış kullanıcı ister, istisnalar
   açıkça yazılır ([AllowAnonymous] ya da AnonymousPaths).

   AdditionalAssemblies şart: /status/{code} sayfası Hydra.RazorClassLibrary içinde yaşıyor ve
   Router varsayılan olarak SADECE uygulama assembly'sini tarar — bu satır olmadan izin reddi
   yönlendirmesi 404'e düşerdi.

   Sunucu tarafındaki PermissionAuthorizationFilter ile aynı mantık — bkz. Academy 5.7. *@

<Router AppAssembly="typeof(Program).Assembly"
        AdditionalAssemblies="new[] { typeof(HydraStatusPage).Assembly }">
    <Found Context="routeData">
        <HydraRouteGuard RouteData="routeData"
                         DefaultLayout="typeof(MainLayout)"
                         AnonymousPaths="@(new[] { "", "login", "status", "error" })" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(EmptyLayout)">
            <HydraStatusPage Code="404" />
        </LayoutView>
    </NotFound>
</Router>
